---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/data/site";
import heroImage from "@/assets/images/hero.jpg";
---

<section class="relative mx-auto max-w-[1500px] px-[22px] pt-[140px]">
  <div class="fx-mag relative h-[540px] overflow-hidden rounded-[22px] min-[820px]:h-[640px]">
    <div class="absolute inset-0 overflow-hidden">
      <Image
        src={heroImage}
        alt="Maison en briques rénovée dans le Nord — menuiseries et fermetures AT HOME"
        class="fx-kenburns h-full w-full object-cover"
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="(max-width: 820px) 100vw, 1456px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(rgba(14,14,14,0.15) 0%, transparent 32%, transparent 45%, rgba(14,14,14,0.82) 100%);"
    >
    </div>

    <div class="absolute inset-x-[18px] top-[26px] z-[2] flex flex-wrap items-center justify-between gap-2 min-[820px]:inset-x-7">
      <span
        class="inline-flex items-center gap-2.5 rounded-full border border-white/28 bg-white/16 px-4 py-[9px] text-[13px] font-semibold text-white backdrop-blur-md"
      >
        <span class="h-2 w-2 rounded-full bg-lime"></span>
        Artisan RGE · {SITE.address.addressLocality} (59) · Depuis {SITE.foundedYear}
      </span>
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/28 bg-white/16 px-4 py-[9px] text-[13px] font-semibold text-white backdrop-blur-md"
      >
        <span class="text-orange">★★★★★</span>
        {SITE.rating.value}/5 · {SITE.rating.count}+ avis Google
      </span>
    </div>

    <div class="absolute inset-x-[18px] bottom-10 z-[2] text-white min-[820px]:inset-x-[42px]">
      <h1
        class="mb-[22px] max-w-[15ch] font-heading text-[clamp(32px,9.4vw,84px)] font-extrabold leading-[0.94] tracking-[-0.03em] min-[820px]:text-[clamp(46px,5.6vw,84px)]"
      >
        On transforme votre maison, à votre image.
      </h1>
      <div class="flex flex-wrap items-center justify-between gap-5">
        <div class="flex flex-wrap items-center gap-4">
          <a href="/devis" class="fx-mag fx-cta inline-flex items-center gap-2.5 rounded-full bg-lime px-[30px] py-[17px] font-heading text-[17px] font-extrabold text-ink">
            <span class="fx-ctadot h-[9px] w-[9px] rounded-full bg-ink"></span>
            Devis gratuit sous 48h
          </a>
          <a
            href="/realisations"
            class="fx-mag inline-flex items-center gap-2.5 rounded-full border-[1.5px] border-white/60 bg-white/12 px-[26px] py-[17px] font-heading text-[17px] font-extrabold text-white backdrop-blur-md"
          >
            Nos réalisations
            <Icon name="arrow-up-right" size={16} strokeWidth={2.4} />
          </a>
        </div>
        <span class="hidden text-sm font-semibold text-white/85 min-[820px]:inline">
          Fenêtres · Volets · Portes · Portails · Isolation · Extension
        </span>
      </div>
    </div>
  </div>
</section>
