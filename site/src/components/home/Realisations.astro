---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { REALISATIONS } from "@/data/realisations";
---

<section id="realisations" aria-labelledby="realisations-heading" class="overflow-hidden py-10">
  <div class="mx-auto flex max-w-[1360px] flex-wrap items-end justify-between gap-5 px-6 pb-8 min-[820px]:px-11">
    <h2 id="realisations-heading" data-reveal class="font-heading text-[clamp(40px,5vw,72px)] font-extrabold leading-[0.95] tracking-[-0.03em]">
      Nos dernières<br />réalisations.
    </h2>
    <div data-reveal class="flex items-center gap-3.5">
      <span class="hidden text-[15px] text-text-muted min-[820px]:inline">Glissez ou naviguez</span>
      <div class="flex gap-2.5">
        <button
          type="button"
          id="realisations-prev"
          aria-label="Réalisations précédentes"
          class="fx-mag flex h-[52px] w-[52px] items-center justify-center rounded-full border-[1.5px] border-ink bg-white text-ink"
        >
          <Icon name="arrow-up-right" size={20} strokeWidth={2.2} class="rotate-[-135deg]" />
        </button>
        <button
          type="button"
          id="realisations-next"
          aria-label="Réalisations suivantes"
          class="fx-mag flex h-[52px] w-[52px] items-center justify-center rounded-full bg-lime text-ink"
        >
          <Icon name="arrow-up-right" size={20} strokeWidth={2.2} class="rotate-45" />
        </button>
      </div>
    </div>
  </div>

  <div id="realisations-track" class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-8 [cursor:grab] min-[820px]:px-11">
    {
      REALISATIONS.map((item) => (
        <div class="group relative h-[330px] w-[66vw] flex-none snap-start overflow-hidden rounded-[26px] min-[820px]:h-[520px] min-[820px]:w-[440px]">
          <Image
            src={item.image}
            alt={item.alt}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-[800ms] group-hover:scale-[1.08]"
            widths={[360, 520, 700, 880]}
            sizes="(max-width: 820px) 66vw, 440px"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-[linear-gradient(transparent_46%,rgba(14,14,14,0.72))]" />
          <span class="absolute left-5 top-5 rounded-full bg-white/92 px-4 py-2 text-[13px] font-bold">{item.category}</span>
          <div class="absolute inset-x-[26px] bottom-6 text-white">
            <div class="font-heading text-[27px] font-extrabold leading-[1.05] tracking-[-0.02em]">{item.title}</div>
          </div>
        </div>
      ))
    }
    <div class="w-[1px] flex-none min-[820px]:w-11" aria-hidden="true"></div>
  </div>
</section>

<script>
  const track = document.getElementById("realisations-track");
  const prevBtn = document.getElementById("realisations-prev");
  const nextBtn = document.getElementById("realisations-next");

  if (track && prevBtn && nextBtn) {
    function cardStep() {
      const card = track!.querySelector<HTMLElement>(":scope > div");
      if (!card) return 400;
      const gap = 20;
      return card.offsetWidth + gap;
    }

    prevBtn.addEventListener("click", () => track!.scrollBy({ left: -cardStep(), behavior: "smooth" }));
    nextBtn.addEventListener("click", () => track!.scrollBy({ left: cardStep(), behavior: "smooth" }));

    let isDown = false;
    let startX = 0;
    let scrollStart = 0;

    track.addEventListener("pointerdown", (event) => {
      isDown = true;
      startX = event.clientX;
      scrollStart = track!.scrollLeft;
      track!.setPointerCapture(event.pointerId);
    });
    track.addEventListener("pointermove", (event) => {
      if (!isDown) return;
      track!.scrollLeft = scrollStart - (event.clientX - startX);
    });
    track.addEventListener("pointerup", () => (isDown = false));
    track.addEventListener("pointercancel", () => (isDown = false));
  }
</script>
