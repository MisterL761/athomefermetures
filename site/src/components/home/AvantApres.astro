---
---

<section aria-labelledby="avant-apres-heading" class="bg-bg-alt">
  <div class="mx-auto grid max-w-[1360px] grid-cols-1 gap-10 px-6 py-16 min-[820px]:grid-cols-[0.9fr_1.1fr] min-[820px]:gap-14 min-[820px]:px-11 min-[820px]:py-[100px]">
    <div data-reveal>
      <span class="badge-pill mb-5 inline-block">AVANT / APRÈS</span>
      <h2 id="avant-apres-heading" class="mb-5 font-heading text-[clamp(38px,4.4vw,60px)] font-extrabold leading-[0.96] tracking-[-0.03em]">
        La différence<br />se voit direct.
      </h2>
      <p class="mb-[30px] max-w-[400px] text-[17px] leading-[1.65] text-text-soft">
        Glissez le curseur : plus de lumière, d'isolation et de valeur pour votre bien après rénovation.
      </p>
      <div class="flex gap-9">
        <div>
          <div class="font-heading text-[50px] font-extrabold leading-none">-40%</div>
          <div class="mt-1.5 text-sm text-text-muted">facture d'énergie</div>
        </div>
        <div>
          <div class="font-heading text-[50px] font-extrabold leading-none">+15%</div>
          <div class="mt-1.5 text-sm text-text-muted">valeur du bien</div>
        </div>
      </div>
    </div>

    <div class="relative h-[360px] overflow-hidden rounded-[26px] shadow-[0_30px_60px_-30px_rgba(14,14,14,0.35)] min-[820px]:h-[460px]" id="avant-apres-slider">
      <div class="absolute inset-0 flex items-end bg-[linear-gradient(150deg,#9a958a,#6f6a5f)]">
        <span class="m-5 rounded-full bg-ink/60 px-3.5 py-[7px] font-heading text-[13px] font-extrabold text-white">AVANT</span>
      </div>
      <div id="avant-apres-clip" class="absolute inset-0" style="clip-path: inset(0 45% 0 0);">
        <div class="absolute inset-0 flex items-end justify-end bg-[linear-gradient(150deg,#a9d15e,#6fae12)]">
          <span class="m-5 rounded-full bg-lime px-3.5 py-[7px] font-heading text-[13px] font-extrabold text-ink">APRÈS</span>
        </div>
      </div>
      <div
        id="avant-apres-handle"
        class="pointer-events-none absolute inset-y-0 z-[4] w-[3px] -translate-x-[1.5px] bg-lime shadow-[0_0_14px_rgba(150,212,40,0.6)]"
        style="left: 55%;"
      >
      </div>
      <div
        id="avant-apres-knob"
        class="pointer-events-none absolute top-1/2 z-[5] flex h-[50px] w-[50px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-lg font-extrabold text-ink shadow-[0_6px_18px_rgba(0,0,0,0.3)]"
        style="left: 55%;"
        aria-hidden="true"
      >
        ⇆
      </div>
      <label for="avant-apres-range" class="sr-only">Comparer avant et après rénovation</label>
      <input
        id="avant-apres-range"
        type="range"
        min="0"
        max="100"
        value="55"
        class="absolute inset-0 z-[6] h-full w-full cursor-ew-resize opacity-0"
      />
    </div>
  </div>
</section>

<script>
  const range = document.getElementById("avant-apres-range") as HTMLInputElement | null;
  const clip = document.getElementById("avant-apres-clip");
  const handle = document.getElementById("avant-apres-handle");
  const knob = document.getElementById("avant-apres-knob");

  function update(value: number) {
    if (clip) clip.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
    if (handle) handle.style.left = `${value}%`;
    if (knob) knob.style.left = `${value}%`;
  }

  if (range) {
    range.addEventListener("input", () => update(Number(range.value)));
  }
</script>
