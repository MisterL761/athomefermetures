---
export interface Crumb {
  name: string;
  path: string;
}

export interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className = "" } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class={`flex items-center gap-2 text-[13.5px] text-text-faint ${className}`}>
  <ol class="flex flex-wrap items-center gap-2">
    {
      crumbs.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === crumbs.length - 1 ? (
            <span class="font-semibold text-ink" aria-current="page">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.path} class="hover:text-ink">
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
