---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/home/Hero.astro";
import QualificationBar from "@/components/home/QualificationBar.astro";
import Presentation from "@/components/home/Presentation.astro";
import Stats from "@/components/home/Stats.astro";
import PrestationsGrid from "@/components/home/PrestationsGrid.astro";
import ZoneIntervention from "@/components/home/ZoneIntervention.astro";
import Realisations from "@/components/home/Realisations.astro";
import AvantApres from "@/components/home/AvantApres.astro";
import CommentCaSePasse from "@/components/home/CommentCaSePasse.astro";
import Avis from "@/components/home/Avis.astro";
import Faq from "@/components/Faq.astro";
import { HOME_FAQ } from "@/data/home-faq";
import { faqSchema } from "@/lib/schema";

const title = "Menuisier & poseur de fermetures à Bailleul (59) | AT HOME Fermetures";
const description =
  "Fenêtres, volets, portes, portails et isolation extérieure à Bailleul (59). Devis gratuit sous 48h, RGE Qualibat, intervention dans un rayon de 50 km.";
---

<Layout title={title} description={description} path="/" jsonLd={[faqSchema(HOME_FAQ)]}>
  <Hero />
  <QualificationBar />
  <Presentation />
  <Stats />
  <PrestationsGrid />
  <ZoneIntervention />
  <Realisations />
  <AvantApres />
  <CommentCaSePasse />
  <Avis />
  <Faq items={HOME_FAQ} />
</Layout>
