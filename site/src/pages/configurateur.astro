---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import { breadcrumbSchema } from "@/lib/schema";
import { CONFIGURATEUR_URL } from "@/data/site";

const crumbs = [
  { name: "Accueil", path: "/" },
  { name: "Configurateur", path: "/configurateur" },
];

const title = "Configurateur de menuiseries K·LINE | AT HOME — Bailleul";
const description =
  "Configurez vos fenêtres, portes et volets en ligne avec l'outil K·LINE, puis affinez votre projet avec nos conseillers AT HOME à Bailleul (59).";

const STEPS = [
  { title: "Configurez en ligne", description: "Choisissez matériaux, coloris et dimensions sur le configurateur K·LINE, en quelques clics." },
  { title: "Un conseiller vous rappelle", description: "Sous 48h, pour affiner votre projet et planifier une visite technique gratuite." },
  { title: "Estimation personnalisée", description: "Un devis détaillé, sans engagement, adapté à votre budget." },
];
---

<Layout title={title} description={description} path="/configurateur" jsonLd={[breadcrumbSchema(crumbs)]}>
  <section class="mx-auto max-w-[1360px] px-6 pt-[150px] min-[820px]:px-11">
    <Breadcrumbs crumbs={crumbs} class="mb-6" />
    <div class="grid grid-cols-1 items-center gap-10 pb-20 min-[820px]:grid-cols-2 min-[820px]:gap-14 min-[820px]:pb-28">
      <div>
        <span class="badge-pill mb-5 inline-block">CONFIGURATEUR K·LINE</span>
        <h1 class="mb-6 font-heading text-[clamp(36px,4.6vw,60px)] font-extrabold leading-[0.96] tracking-[-0.03em]">
          Configurez votre projet, on s'occupe du reste.
        </h1>
        <p class="mb-8 text-lg leading-[1.65] text-text-soft">
          Utilisez le configurateur en ligne K·LINE pour choisir matériaux, coloris et dimensions de vos fenêtres, portes ou volets, puis laissez nos conseillers affiner votre estimation.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a href={CONFIGURATEUR_URL} target="_blank" rel="noopener" class="btn-primary fx-mag fx-cta">
            <span class="fx-ctadot h-[9px] w-[9px] rounded-full bg-ink"></span>
            Ouvrir le configurateur
          </a>
          <a href="/devis" class="btn-outline fx-mag">Démarrer ma demande</a>
        </div>
      </div>
      <div class="rounded-3xl border border-border-card bg-bg-alt p-8 min-[820px]:p-10">
        <ol class="flex flex-col gap-7">
          {
            STEPS.map((step, index) => (
              <li class="flex gap-4.5">
                <div class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-ink font-heading text-lg font-extrabold text-lime">
                  {index + 1}
                </div>
                <div>
                  <h2 class="mb-1 font-heading text-lg font-extrabold">{step.title}</h2>
                  <p class="text-[15px] leading-[1.6] text-text-soft">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="mx-auto flex max-w-[1360px] flex-wrap items-center justify-between gap-6 px-6 py-14 min-[820px]:px-11">
      <div class="flex items-center gap-3.5">
        <Icon name="pin" size={22} class="text-lime" />
        <p class="text-[15px] text-text-soft">
          Envie d'un aperçu concret ? Notre showroom de 300 m² à Bailleul présente nos gammes en situation réelle.
        </p>
      </div>
      <a href="/societe" class="fx-mag inline-flex items-center gap-2 rounded-full border-[1.5px] border-ink px-6 py-3 font-heading text-sm font-extrabold text-ink">
        Découvrir le showroom
      </a>
    </div>
  </section>
</Layout>
